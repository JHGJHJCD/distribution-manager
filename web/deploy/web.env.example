# The site's settings on the server. Copy to /etc/haluka/web.env (chmod 600) and fill in.
# NOTHING of the filled file goes to git: the repository is public.

# Where the data lives (database, backups, users, sessions). Outside the code folder.
HALUKA_WEB_DATA=/opt/haluka/data

# The names the site answers to, with commas. Any name other than 127.0.0.1 / localhost
# switches the login on, and nothing can switch it off.
# A fixed name:            HALUKA_WEB_HOSTS=haluka.example.org
# Cloudflare quick tunnel: HALUKA_WEB_HOSTS=*.trycloudflare.com
HALUKA_WEB_HOSTS=

# Entering with Google (see web/google_login.py). The address must be https and fixed.
#HALUKA_WEB_URL=https://haluka.example.org
#HALUKA_GOOGLE_CLIENT_ID=
#HALUKA_GOOGLE_CLIENT_SECRET=

# The daily copy that leaves the server — ONE of the two (see web/offsite.py):
#HALUKA_OFFSITE_DIR=/mnt/away/haluka
#HALUKA_OFFSITE_CMD=rclone copy {file} away:haluka

PYTHONUTF8=1
